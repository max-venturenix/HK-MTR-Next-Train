{
  "expo": {
    "name": "MTR Next Train",
    "slug": "mtr-next-train",
    "version": "2.5.1",
    "orientation": "default",
    "icon": "./assets/ic_launcher.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "blockedPermissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sps99133.mtrnexttrain",
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "9e453fc8-8561-4f5e-ba81-5952667393f7"
      }
    },
    "scheme": "mtr-next-train",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ic_launcher.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-background-task",
      "./plugins/withWorkManagerKeepRules",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "react-native-background-fetch"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
